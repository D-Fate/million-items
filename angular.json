{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "million-items": {
      "projectType": "application",
      "root": "client",
      "sourceRoot": "client/src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/client",
            "index": "client/src/index.html",
            "browser": "client/src/main.ts",
            "tsConfig": "client/tsconfig.app.json",
            "styles": ["client/src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "client/public" }]
          },
          "configurations": {
            "production": {
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
              "budgets": [{ "type": "initial", "maximumWarning": "600kB", "maximumError": "800kB" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "million-items:build:production" },
            "development": { "buildTarget": "million-items:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
