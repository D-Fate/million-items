{
  "name": "million-items",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "ng serve --host 127.0.0.1 --proxy-config client/proxy.conf.json",
    "build": "npm run build:client && npm run build:server",
    "build:client": "ng build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/server/src/index.js",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tsconfig.tests.json && ng build --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "check": "npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
